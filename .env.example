# Local dev: Vite proxies POST /api → this Web app URL
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxrzEPVUjv3NCYJNd7IAcPS2NQc3c0LP7VBErkr06YDviFwqzsCYASRAlsQxAtXftbX/exec

# The spreadsheet is NOT configured here — link it in Google Apps Script:
# Project settings → Script properties → SPREADSHEET_ID = ID from your sheet URL
#   https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
# Also set SESSION_SECRET and ADMIN_SESSION_SECRET (see docs/APPS_SCRIPT_DEPLOY.md)

# Production (Netlify dashboard → Environment variables):
# APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxrzEPVUjv3NCYJNd7IAcPS2NQc3c0LP7VBErkr06YDviFwqzsCYASRAlsQxAtXftbX/exec
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...  (secret; Functions only)
# VITE_RAZORPAY_KEY_ID=rzp_test_...  (same as Key Id; required for online checkout UI)

# Apps Script Script properties (cloud project, not .env):
# RAZORPAY_KEY_SECRET = same test/live secret as Netlify — see docs/RAZORPAY_SETUP.md

# Optional override (default is /api proxy):
# VITE_API_URL=/api
